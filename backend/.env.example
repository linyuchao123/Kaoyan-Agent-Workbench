APP_ENV=development
APP_ORIGINS=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# 旧版统一配置：仅使用同一家 OpenAI 兼容服务时填写。
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 聊天 / Agent（示例：DeepSeek）
CHAT_PROVIDER=deepseek
CHAT_DEFAULT_PROFILE=flash
CHAT_API_KEY=
CHAT_BASE_URL=https://api.deepseek.com
CHAT_FLASH_MODEL=deepseek-v4-flash
CHAT_PRO_MODEL=deepseek-v4-pro
# DeepSeek 不可用时的聊天备用模型（示例：阿里云百炼）
CHAT_FALLBACK_PROVIDER=qwen
CHAT_FALLBACK_API_KEY=
CHAT_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_FALLBACK_FLASH_MODEL=qwen3.5-flash-2026-02-23
CHAT_FALLBACK_PRO_MODEL=qwen3.7-plus
# 向量模型（示例：阿里云百炼）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# 图片与扫描 PDF OCR（示例：阿里云百炼）
OCR_API_KEY=
OCR_BASE_URL=
OCR_MODEL=gpt-5-mini
OCR_MAX_PAGES=100
OCR_POLL_SECONDS=5
PDFTOPPM_PATH=pdftoppm
TAVILY_API_KEY=
DEMO_MODE=true
