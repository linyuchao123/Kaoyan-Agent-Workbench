APP_ENV=development
APP_ORIGINS=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# 旧版统一配置：仅使用同一家 OpenAI 兼容服务时填写。
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 聊天 / Agent（示例：DeepSeek）
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL=gpt-5-mini
# 向量模型（示例：阿里云百炼）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# 图片与扫描 PDF OCR（示例：阿里云百炼）
OCR_API_KEY=
OCR_BASE_URL=
OCR_MODEL=gpt-5-mini
OCR_MAX_PAGES=100
OCR_POLL_SECONDS=5
PDFTOPPM_PATH=pdftoppm
TAVILY_API_KEY=
DEMO_MODE=true
